{
  "name": "dataquire",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 5173",
    "build": "astro build && node scripts/postbuild.mjs",
    "preview": "node scripts/preview.mjs",
    "lint": "eslint .",
    "check": "node --check app.js && node --check config.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm run lint && npm run typecheck && npm test && npm run build && node scripts/verify-build.mjs"
  },
  "devDependencies": {
    "astro": "^7.3.8",
    "eslint": "^10.12.0",
    "linkedom": "^0.18.13",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "qrcode": "^1.5.4"
  }
}
